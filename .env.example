# Copie este arquivo para .env e ajuste os valores.
# Carregue no terminal com:  set -a; source .env; set +a

DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (se POSTGRES_DB ficar vazio, o projeto usa SQLite para testes rápidos)
POSTGRES_DB=amcnm
POSTGRES_USER=amcnm
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
